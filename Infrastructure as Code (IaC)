provider "aws" {
  region = "us-east-1" # Update with your desired region
}

resource "aws_instance" "example" {
  ami           = "ami-0abcdef1234567890" # Replace with a Windows AMI ID
  instance_type = "t3.micro"

  tags = {
    Name = "WSUS-Registry-Update"
  }

  # Attach IAM Role for SSM
  iam_instance_profile = aws_iam_instance_profile.ssm_profile.name
}

resource "aws_iam_role" "ssm_role" {
  name = "SSMRole"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ec2.amazonaws.com"
        }
      }
    ]
  })
}

resource "aws_iam_policy_attachment" "ssm_policy_attachment" {
  name       = "ssm-policy-attachment"
  roles      = [aws_iam_role.ssm_role.name]
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_instance_profile" "ssm_profile" {
  name = "SSMInstanceProfile"
  role = aws_iam_role.ssm_role.name
}

resource "aws_ssm_document" "update_registry" {
  name          = "UpdateRegistry"
  document_type = "Command"

  content = jsonencode({
    schemaVersion = "2.2"
    description   = "Update the registry to enable cert padding check."
    mainSteps     = [
      {
        action = "aws:runPowerShellScript"
        name   = "UpdateRegistry"
        inputs = {
          runCommand = [
            "New-Item -Path HKLM:\\Software\\Microsoft\\Cryptography\\Wintrust\\Config -Force",
            "Set-ItemProperty -Path HKLM:\\Software\\Microsoft\\Cryptography\\Wintrust\\Config -Name EnableCertPaddingCheck -Value 1"
          ]
        }
      }
    ]
  })
}

resource "aws_ssm_association" "run_update_registry" {
  name            = aws_ssm_document.update_registry.name
  instance_id     = aws_instance.example.id
  wait_for_success_timeout_seconds = 300 # Wait for up to 5 minutes
}
